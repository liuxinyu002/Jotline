# —— Jotline 开发环境约定（Roadmap 总则 4，Phase-1 定稿）——
# 复制为 .env 后按需修改；各端口的实际消费方见 README「本地开发」。

# 领域 API（Rust 主进程，Phase-2 起监听）：127.0.0.1:4765
# 契约 Mock 服务（Phase-1 起可用）：127.0.0.1:4766（MOCK_PORT 可覆盖，见下）
# 前端 dev server（Phase-2 起启用）：127.0.0.1:1420

# dev Bearer token（经 .env 注入，server / app / sidecar / Mock 四端一致；
# 未设置时四端缺省 dev-token；仅本地开发，勿用于任何真实环境）
JOTLINE_DEV_TOKEN=dev-token

# 数据目录（= vault 根目录，非其父目录；默认 ./vault，相对启动目录——
# pnpm dev 一律以仓库根拉起子进程；首次启动自动初始化全布局并 seed 示例项目）
JOTLINE_DATA_DIR=./vault

# DeepSeek API key（Phase-8 起 provider 层使用；Phase-1/2 无需配置）
DEEPSEEK_API_KEY=

# Mock 端口覆盖（默认 4766，一般无需修改；Mock 同样经 .env 或进程环境读取）
# MOCK_PORT=4766
